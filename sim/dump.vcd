    $var wire 32 #! i [31:0] $end
    $var wire 32 $! j [31:0] $end
   $upscope $end
  $upscope $end
 $upscope $end
 $var wire 1 # clk_h $end
 $var wire 1 $ clk_l $end
 $var wire 1 % rst_n $end
 $var wire 8 & cfg_addr [7:0] $end
 $var wire 32 ' cfg_data_in [31:0] $end
 $var wire 32 ( cfg_data_out [31:0] $end
 $var wire 1 ) cfg_valid $end
 $var wire 1 * cfg_ready $end
 $var wire 1 + a_valid $end
 $var wire 1 , a_ready $end
 $var wire 3 - a_opcode [2:0] $end
 $var wire 3 . a_param [2:0] $end
 $var wire 3 / a_size [2:0] $end
 $var wire 4 0 a_source [3:0] $end
 $var wire 32 1 a_address [31:0] $end
 $var wire 4 2 a_mask [3:0] $end
 $var wire 32 3 a_data [31:0] $end
 $var wire 1 4 d_valid $end
 $var wire 1 5 d_ready $end
 $var wire 3 6 d_opcode [2:0] $end
 $var wire 2 7 d_param [1:0] $end
 $var wire 3 8 d_size [2:0] $end
 $var wire 4 9 d_source [3:0] $end
 $var wire 4 : d_sink [3:0] $end
 $var wire 1 ; d_denied $end
 $var wire 32 < d_data [31:0] $end
 $var wire 1 = d_corrupt $end
$enddefinitions $end


